# Database
DATABASE_URL=postgresql://cyclist:cyclist@localhost:5432/cycletourmap

# JWT Secret for API authentication
JWT_SECRET=your-jwt-secret-key-here

# Strava OAuth (server-side)
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret

# Frontend environment variables (Vite uses VITE_ prefix)
VITE_API_URL=http://localhost:3001/api
VITE_REDIRECTURI=http://localhost:5173/dashboard
VITE_STRAVA_CLIENTID=your-strava-client-id
VITE_GOOGLE_MAPS_APIKEY=your-google-maps-api-key
