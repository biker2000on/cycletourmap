    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.7.1",
    "leaflet.fullscreen": "^2.2.0",
    "leaflet.gridlayer.googlemutant": "^0.13.4",
    "lodash.pick": "^4.4.0",
    "moment": "^2.29.1",
    "pg": "^8.17.2",
    "roboto-fontface": "*",
    "uuid": "^9.0.0",
    "vue": "^3.5.26",
    "vue-router": "^4.5.0",
